@model TPLOCAL1.Models.FormModel

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <title>Page de validation</title>
    <link rel="stylesheet" href="~/resources/Site.css" />
</head>
<body>

<header>
    <img src="~/resources/GroupeHN.png"
         class="image"
         alt="Logo Groupe HN" />

    <h1>Page de validation</h1>
</header>

<div class="page">
    <nav>
        <ul>
            <li><a href="/">Accueil</a></li>

            <li>
                <a asp-controller="Home"
                   asp-action="Index"
                   asp-route-id="Form">
                    Remplir le formulaire
                </a>
            </li>

            <li>
                <a asp-controller="Home"
                   asp-action="Index"
                   asp-route-id="OpinionList">
                    Liste des avis
                </a>
            </li>
        </ul>
    </nav>

    <main>
        <p class="confirmation">
            Votre formulaire a été pris en compte
        </p>

        <table class="form-table">
            <caption>Informations personnelles</caption>
            <tr><td>Nom</td><td>@Model.LastName</td></tr>
            <tr><td>Prénom</td><td>@Model.FirstName</td></tr>
            <tr><td>Sexe</td><td>@Model.Gender</td></tr>
            <tr><td>Adresse</td><td>@Model.Address</td></tr>
            <tr><td>Code postal</td><td>@Model.ZipCode</td></tr>
            <tr><td>Ville</td><td>@Model.City</td></tr>
            <tr><td>Adresse mail</td><td>@Model.Email</td></tr>
        </table>

        <table class="form-table">
            <caption>Informations sur la formation suivie</caption>
            <tr>
                <td>Date de début</td>
                <td>@Model.StartDate?.ToString("dd/MM/yyyy")</td>
            </tr>
            <tr>
                <td>Formation suivie</td>
                <td>@Model.TrainingType</td>
            </tr>
        </table>

        <table class="form-table">
            <caption>Avis sur la formation</caption>
            <tr>
                <td>Formation Cobol</td>
                <td>@Model.CobolOpinion</td>
            </tr>
            <tr>
                <td>Formation C#</td>
                <td>@Model.CSharpOpinion</td>
            </tr>
        </table>
    </main>
</div>

</body>
</html>