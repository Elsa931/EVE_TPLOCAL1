@model TPLOCAL1.Models.FormModel

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <title>Formulaire</title>
    <link rel="stylesheet" href="~/resources/Site.css" />
</head>
<body>
<header>
    <img src="~/resources/GroupeHN.png" class="image" alt="Logo Groupe HN" />
    <h1>Formulaire TP HN avis</h1>
</header>

<div class="page">
    <nav>
        <ul>
            <li><a href="/">Accueil</a></li>
            <li>
                <a asp-action="Index" asp-route-id="OpinionList">
                    Liste des avis
                </a>
            </li>
        </ul>
    </nav>

    <main>
        <form asp-controller="Home"
              asp-action="ValidationFormulaire"
              method="post">

            <div asp-validation-summary="All"></div>

            <table class="form-table">
                <caption>Informations personnelles</caption>
                <tr>
                    <td><label asp-for="LastName">Nom</label></td>
                    <td>
                        <input asp-for="LastName" />
                        <span asp-validation-for="LastName"></span>
                    </td>
                </tr>
                <tr>
                    <td><label asp-for="FirstName">Prénom</label></td>
                    <td>
                        <input asp-for="FirstName" />
                        <span asp-validation-for="FirstName"></span>
                    </td>
                </tr>
                <tr>
                    <td><label asp-for="Gender">Sexe</label></td>
                    <td>
                        <select asp-for="Gender">
                            <option value="">Sélectionner un sexe</option>
                            <option value="Homme">Homme</option>
                            <option value="Femme">Femme</option>
                            <option value="Autre">Autre</option>
                        </select>
                        <span asp-validation-for="Gender"></span>
                    </td>
                </tr>
                <tr>
                    <td><label asp-for="Address">Adresse</label></td>
                    <td>
                        <input asp-for="Address" />
                        <span asp-validation-for="Address"></span>
                    </td>
                </tr>
                <tr>
                    <td><label asp-for="ZipCode">Code postal</label></td>
                    <td>
                        <input asp-for="ZipCode" placeholder="Exemple : 94700" />
                        <span asp-validation-for="ZipCode"></span>
                    </td>
                </tr>
                <tr>
                    <td><label asp-for="City">Ville</label></td>
                    <td>
                        <input asp-for="City" />
                        <span asp-validation-for="City"></span>
                    </td>
                </tr>
                <tr>
                    <td><label asp-for="Email">Adresse mail</label></td>
                    <td>
                        <input asp-for="Email" type="email" />
                        <span asp-validation-for="Email"></span>
                    </td>
                </tr>
            </table>

            <table class="form-table">
                <caption>Informations sur la formation suivie</caption>
                <tr>
                    <td><label asp-for="StartDate">Date de début</label></td>
                    <td>
                        <input asp-for="StartDate"
                               type="date"
                               max="2020-12-31" />
                        <span asp-validation-for="StartDate"></span>
                    </td>
                </tr>
                <tr>
                    <td><label asp-for="TrainingType">Formation suivie</label></td>
                    <td>
                        <select asp-for="TrainingType">
                            <option value="">Sélectionner une formation</option>
                            <option value="Cobol">Formation Cobol</option>
                            <option value="Objet">Formation par objet</option>
                            <option value="Double compétence">
                                Formation à double compétence
                            </option>
                        </select>
                        <span asp-validation-for="TrainingType"></span>
                    </td>
                </tr>
            </table>

            <table class="form-table">
                <caption>Avis sur la formation</caption>
                <tr>
                    <td><label asp-for="CobolOpinion">Formation Cobol</label></td>
                    <td><textarea asp-for="CobolOpinion"></textarea></td>
                </tr>
                <tr>
                    <td><label asp-for="CSharpOpinion">Formation C#</label></td>
                    <td><textarea asp-for="CSharpOpinion"></textarea></td>
                </tr>
            </table>

            <button type="submit">Valider</button>
        </form>
    </main>
</div>
</body>
</html>